{
  "manifest_version": 3,
  "name": "BrowserTrust",
  "version": "0.1.0",
  "description": "Shows what websites do with the access they have. Phase 1 foundation: no monitoring collectors yet.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "BrowserTrust",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "optional_permissions": ["webRequest"],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
